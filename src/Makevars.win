# zuutf build flags: design §12.2. No -m, -f, -O or -std token may appear in
# a PKG_*FLAGS variable (R CMD check warns); simdutf picks its x86-64 kernels
# with function-level target attributes, so none is needed. The visibility
# macros come from R's Makeconf and keep every symbol but R_init_zuutf
# hidden (R3).
CXX_STD = CXX17

PKG_CPPFLAGS = -Ivendor/simdutf -DSIMDUTF_IMPLEMENTATION_FALLBACK=1
PKG_CFLAGS = $(C_VISIBILITY)
PKG_CXXFLAGS = $(CXX_VISIBILITY)

# The amalgamation sits in a subdirectory, which R does not compile by
# itself, so every object is listed.
OBJECTS = init.o zut_info.o zut_impl.o vendor/simdutf/simdutf.o
